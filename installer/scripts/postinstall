# The prototype ships inside the app; hardware loading is currently blocked.
# Remove an older boot-time copy if present; macOS updates the kernel collection
# on the next restart. This installer never installs a boot-time kext.
if [[ -d /Library/Extensions/RTL8852BEWiFi.kext ]]; then
    /bin/rm -rf /Library/Extensions/RTL8852BEWiFi.kext
    /usr/bin/logger -t rtl8852be-installer "removed /Library/Extensions/RTL8852BEWiFi.kext"
fi
/usr/bin/xattr -dr com.apple.quarantine "/Applications/RTL8852BE Wireless Utility.app" 2>/dev/null || true
exit 0
